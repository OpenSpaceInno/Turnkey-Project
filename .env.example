# ==============================================================================
# Kanak TurnKey — Environment Variables Template
# Copy this file to .env and replace placeholders with production values
# ==============================================================================

# Node Environment ('production' for VPS deployment, 'development' for local)
NODE_ENV=production
PORT=3000

# Frontend URL (for CORS and session cookies)
FRONTEND_URL=https://your-domain.com
APP_BASE_URL=https://your-domain.com

# ------------------------------------------------------------------------------
# Security Configuration
# ------------------------------------------------------------------------------
# MANDATORY: Generate using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=your_secure_64_byte_hex_session_secret_here

# Cookie security: Set to true when running behind HTTPS with SSL certificate (recommended)
COOKIE_SECURE=false

# ------------------------------------------------------------------------------
# Initial Super Admin Bootstrap (Created automatically on first boot if DB is empty)
# ------------------------------------------------------------------------------
ADMIN_NAME=Ganesh
ADMIN_EMAIL=ganesh@gmail.com
ADMIN_PHONE=9876543220
ADMIN_PASSWORD=ganesh123

# ------------------------------------------------------------------------------
# Database Configuration (MySQL 8.0+)
# ------------------------------------------------------------------------------
DATABASE_URL=mysql://dbuser:StrongPasswordHere@localhost:3306/turnkey_db

# ------------------------------------------------------------------------------
# Cloudflare R2 / AWS S3 Object Storage (Sprint S1-B)
# ------------------------------------------------------------------------------
# Optional: If omitted, uploads are safely stored in local ./uploads directory
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY_ID=your_r2_access_key_id
# R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# R2_BUCKET_NAME=turnkey-uploads
# R2_PUBLIC_URL=https://cdn.your-domain.com

# ------------------------------------------------------------------------------
# Email Notifications / SMTP (Sprint S1-C - Resend / Postmark / SendGrid / Custom SMTP)
# ------------------------------------------------------------------------------
# Optional: If omitted, emails are recorded in database and simulated in outbox
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=re_your_api_key_here
# SMTP_FROM="Kanak TurnKey ERP" <notifications@your-domain.com>
